# האתר "לצעוד לתוך היום" בשרת הענן. הקובץ נטען מתוך /etc/caddy/Caddyfile בשורה:
#   import /etc/caddy/sites/*.caddy
# הקבצים עצמם ב-/opt/latzod/current (קישור לגרסה האחרונה ב-/opt/latzod/releases).
# /api מועבר לשירות ההזמנות המקומי בפורט 3741.
latzod.64-176-173-124.sslip.io {
	encode gzip

	# שירות ההזמנות החד פעמיות (server/invites.mjs, יחידת systemd latzod-invites)
	handle /api/* {
		reverse_proxy 127.0.0.1:3741
	}

	handle {
		root * /opt/latzod/current
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		Strict-Transport-Security "max-age=31536000"
	}

	# הדף, ה-service worker והמניפסט נבדקים מחדש בכל פעם, כדי שעדכונים יגיעו מיד
	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"

	# הגרסה של Caddy בשרת לא מכירה את סוג הקובץ של המניפסט
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# קובצי תזכורות לאייפון: Safari מזהה אותם כאירועי יומן
	@ics path /reminders/*
	header @ics Content-Type "text/calendar; charset=utf-8"

	# קבצי הבנייה נושאים חותמת בשם, ולכן אפשר לשמור אותם במטמון לזמן רב
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
